// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Fields:
//   - uid: string (required)
//   - balance: number (required)
//   - displayName: string
//   - email: string
//   - photoURL: string
//   - createdAt: timestamp
//
// Collection: markets
// Fields:
//   - question: string (required)
//   - outcomeA: string (required)
//   - outcomeB: string (required)
//   - outcomeAPrice: number (required)
//   - outcomeBPrice: number (required)
//   - volume: number
//   - liquidity: number
//   - status: string (open, closed, resolved)
//   - expiresAt: timestamp
//
// Collection: bets
// Fields:
//   - userId: string (required)
//   - marketId: string (required)
//   - outcome: string (A or B)
//   - amount: number
//   - shares: number
//   - price: number
//   - createdAt: timestamp

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "palotespedro534@gmail.com" && request.auth.token.email_verified == true));
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'balance']) &&
             data.uid is string &&
             data.balance is number && data.balance >= 0;
    }

    function isValidMarket(data) {
      return data.keys().hasAll(['question', 'outcomeA', 'outcomeB', 'outcomeAPrice', 'outcomeBPrice', 'status']) &&
             data.outcomeAPrice >= 0 && data.outcomeAPrice <= 1 &&
             data.outcomeBPrice >= 0 && data.outcomeBPrice <= 1;
    }

    function isValidBet(data) {
      return data.keys().hasAll(['userId', 'marketId', 'outcome', 'amount', 'shares', 'price', 'fee']) &&
             data.userId == request.auth.uid &&
             data.fee is number && data.fee >= 0;
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid;
    }

    match /markets/{marketId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bets/{betId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBet(request.resource.data);
      allow update, delete: if false; // Bets are immutable
    }
  }
}
